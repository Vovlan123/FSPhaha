# Скопируйте в .env и при необходимости измените. Все значения имеют безопасные для демо значения по умолчанию.
PUBLIC_URL=http://localhost:8080
POSTGRES_PASSWORD=fsp_dev_password
SECRET_KEY=change-me-please-very-long-random-string
FSP_CLIENT_SECRET=fsp-talent-secret
# Показывать ссылку подтверждения email прямо на экране (демо-режим)
DEMO_EXPOSE_LINKS=true
# 1 — пересоздавать демо-данные при каждом старте бэкенда; 0 — сохранять данные
SEED_ON_START=1
